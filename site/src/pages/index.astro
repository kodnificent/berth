      '<span class="dim">next</span>       use http://fix-checkout.localhost:20000 to reach this berth\'s app, not localhost or main\'s URL',
      ' ',
      P + 'npm run dev',
      '<span class="ok">✓</span> http://fix-checkout.localhost:<span class="as">20000</span>'
    ]),
    db: add.concat([
      'Added berth 9f2c4e1ab07d3355 for /code/shop/.worktrees/fix-checkout',
      '<span class="dim">name</span>                         fix-checkout',
      '<span class="dim">url</span>                          http://fix-checkout.localhost:<span class="as">20000</span>',
      '<span class="dim">port app</span>                     <span class="as">20000</span> (assign)',
      '<span class="dim">database shop__fix_checkout</span>  <span class="ok">✓ ready</span> (fresh, from shop)',
      '<span class="dim">next</span>                         use http://fix-checkout.localhost:20000 to reach this berth\'s app, not localhost or main\'s URL',
      ' ',
      P + 'python manage.py migrate',
      '<span class="ok">✓</span> migrated shop__fix_checkout  <span class="dim">shop is untouched</span>'
    ]),
    compose: wt.concat([P + 'berth add --wait']).concat([
      '<span class="dim">berth: cloned volume mysql (copy, 1.1 GB) in 6.2s</span>',
      'Added berth 9f2c4e1ab07d3355 for /code/shop/.worktrees/fix-checkout',
      '<span class="dim">name</span>          fix-checkout',
      '<span class="dim">url</span>           http://fix-checkout.localhost:<span class="as">20000</span>',
      '<span class="dim">port web:80</span>   <span class="as">20000</span> (assign)',
      '<span class="dim">port vite</span>     <span class="as">20001</span> (assign)',
      '<span class="dim">volume mysql</span>  <span class="ok">✓ ready</span> (copy, 1.1 GB)',
      '<span class="dim">next</span>          use http://fix-checkout.localhost:20000 to reach this berth\'s app, not localhost or main\'s URL',
      ' ',
      P + 'docker compose up -d',
      '<span class="ok">✓</span> http://fix-checkout.localhost:<span class="as">20000</span>'
    ])
  };

  var out = document.getElementById('term-out');
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tabs button'));
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var timers = [];

  function render(stack, animate) {
    timers.forEach(clearTimeout); timers = [];
    out.innerHTML = scripts[stack].map(function (l) {
      return '<span class="l' + (animate ? ' pending' : '') + '">' + l + '</span>';
    }).join('');
    if (!animate) return;
    var lines = out.querySelectorAll('.l');
    var t = 80;
    lines.forEach(function (l) {
      t += l.querySelector('.pr') ? 520 : 140;
      timers.push(setTimeout(function () { l.classList.remove('pending'); }, t));
    });
  }

  tabs.forEach(function (b) {
    b.addEventListener('click', function () {
      tabs.forEach(function (o) { o.setAttribute('aria-selected', o === b ? 'true' : 'false'); });
      render(b.getAttribute('data-stack'), !reduce);
    });
  });

  render('dev', false);

  var installs = {
    unix: '<span class="pr">$</span> curl -fsSL https://useberth.dev/install | sh',
    windows: '<span class="pr">&gt;</span> irm https://useberth.dev/install.ps1 | iex',
    go: '<span class="pr">$</span> go install github.com/kodnificent/berth/cmd/berth@latest'
  };
  var osTabs = Array.prototype.slice.call(document.querySelectorAll('.os button'));
  var installOut = document.getElementById('install-cmd');
  function pickOs(os) {
    osTabs.forEach(function (b) { b.setAttribute('aria-selected', b.getAttribute('data-os') === os ? 'true' : 'false'); });
    installOut.innerHTML = installs[os];
  }
  osTabs.forEach(function (b) { b.addEventListener('click', function () { pickOs(b.getAttribute('data-os')); }); });
  if (/Windows/.test(navigator.userAgent || '')) pickOs('windows');
})();
</script>
