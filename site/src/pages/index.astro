<script is:inline>
(function () {
  var P = '<span class="pr">$</span> ';
  var wt = [P + 'git worktree add .worktrees/fix-checkout', P + 'cd .worktrees/fix-checkout'];
  var add = wt.concat([P + 'berth add']);
  var scripts = {
    dev: add.concat([
