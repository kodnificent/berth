<meta name="description" content="Every git worktree gets its own environment: ports, names, files and data.">
<link rel="canonical" href="https://useberth.dev/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Berth">
<meta property="og:url" content="https://useberth.dev/">
<meta property="og:title" content="Berth: every git worktree gets its own environment">
<meta property="og:description" content="Every git worktree gets its own environment: ports, names, files and data.">
<meta property="og:image" content="https://useberth.dev/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="git worktree copies your code. Berth copies everything else.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://useberth.dev/og.png">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style is:global>
/* Layout: five short sections on quiet paper. Three dark surfaces only (hero terminal, agents, get started). Orange marks what berth assigns, and the main button. */
:root {
  --paper: #f3f6f6;
  --paper-2: #e7eded;
  --ink: #13283a;
  --muted: #5a6d78;
  --rule: #d3dcde;
  --signal: #d4501c;
  --signal-ink: #ffffff;
  --ok: #2f7a5a;
  --term-bg: #13283a;
  --term-fg: #dde7eb;
  --term-dim: #8aa1ad;
  --term-accent: #ff8a57;
  --term-ok: #7fd1a8;
  --term-rule: rgba(255, 255, 255, 0.08);
  --display: "Big Shoulders Display", "Arial Narrow", "Helvetica Neue", sans-serif;
  --body: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #0d1a24; --paper-2: #13232f; --ink: #e4edf0; --muted: #94a8b2; --rule: #213645;
    --signal: #ff7a45; --signal-ink: #10161a; --ok: #6cc79c;
    --term-bg: #07121a; --term-fg: #dde7eb; --term-dim: #7b939f; --term-accent: #ff8a57; --term-ok: #7fd1a8; --term-rule: rgba(255, 255, 255, 0.07);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #0d1a24; --paper-2: #13232f; --ink: #e4edf0; --muted: #94a8b2; --rule: #213645;
  --signal: #ff7a45; --signal-ink: #10161a; --ok: #6cc79c;
  --term-bg: #07121a; --term-fg: #dde7eb; --term-dim: #7b939f; --term-accent: #ff8a57; --term-ok: #7fd1a8; --term-rule: rgba(255, 255, 255, 0.07);
  color-scheme: dark;
}

* { box-sizing: border-box; }
body { background: var(--paper); color: var(--ink); font: 400 17px/1.6 var(--body); -webkit-font-smoothing: antialiased; }
.wrap { max-width: 1080px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
a { color: inherit; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; border-radius: 3px; }
code { font-family: var(--mono); font-size: 0.86em; }
p { margin: 0; }
h1 { margin: 0; font: 800 clamp(3rem, 7.2vw, 5.4rem)/0.96 var(--display); text-transform: uppercase; letter-spacing: 0.005em; text-wrap: balance; }
h2 { margin: 0; font: 600 clamp(1.7rem, 3.4vw, 2.4rem)/1.15 var(--body); letter-spacing: -0.015em; text-wrap: balance; }
.lede { color: var(--muted); font-size: 1.08rem; max-width: 58ch; }
section { padding-block: clamp(64px, 9vw, 104px); }
section + section { border-top: 1px solid var(--rule); }

.btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border-radius: 6px; font: 600 0.95rem/1 var(--body); text-decoration: none; cursor: pointer; border: 1px solid transparent; }
.btn.primary { background: var(--signal); color: var(--signal-ink); }
.btn.secondary { border-color: var(--rule); color: var(--ink); }
.btn.secondary:hover { border-color: var(--muted); }
.actions { display: flex; flex-wrap: wrap; gap: 12px; }

header.top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--paper); }
header.top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 16px; }
.mark { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 800 1.55rem/1 var(--display); letter-spacing: 0.02em; }
.mark svg { width: 24px; height: 24px; }
nav.links { display: flex; gap: 24px; font-size: 0.93rem; }
nav.links a { text-decoration: none; color: var(--muted); }
nav.links a:hover { color: var(--ink); }

/* hero */
.hero { padding-block: clamp(40px, 6vw, 72px) clamp(64px, 8vw, 96px); }
.hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
@media (max-width: 900px) { .hero .wrap { grid-template-columns: minmax(0, 1fr); } }
.hero-copy { display: grid; gap: 24px; min-width: 0; }
.hero h1 .copy { color: var(--signal); }
.hero .lede { color: var(--ink); opacity: 0.85; font-size: 1.14rem; }
.works { font-size: 0.9rem; color: var(--muted); }

.term { background: var(--term-bg); color: var(--term-fg); border-radius: 10px; overflow: hidden; min-width: 0; }
.tabs { display: flex; gap: 2px; padding: 8px 8px 0; border-bottom: 1px solid var(--term-rule); overflow-x: auto; }
.tabs button { all: unset; cursor: pointer; padding: 9px 12px 10px; font: 500 0.78rem/1 var(--mono); color: var(--term-dim); border-bottom: 2px solid transparent; white-space: nowrap; }
.tabs button[aria-selected="true"] { color: var(--term-fg); border-bottom-color: var(--term-accent); }
.tabs button:hover { color: var(--term-fg); }
.term pre { margin: 0; padding: 18px 18px 22px; font: 400 0.84rem/1.75 var(--mono); white-space: pre; overflow-x: auto; min-height: 18.2em; }
.term .l { display: block; }
.term .l.pending { visibility: hidden; }
.pr { color: var(--term-dim); }
.dim { color: var(--term-dim); }
.ok { color: var(--term-ok); }
.as { color: var(--term-accent); }

/* collisions */
.fights { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
@media (max-width: 900px) { .fights { grid-template-columns: minmax(0, 1fr); } }
.fights .intro { display: grid; gap: 18px; }
.fight-list { list-style: none; margin: 0; padding: 0; display: grid; }
.fight-list li { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
.fight-list li:first-child { padding-top: 0; }
@media (max-width: 520px) { .fight-list li { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
.fight-list b { font-weight: 600; }
.fight-list span { color: var(--muted); }
.answer { margin-top: 24px; font-size: 1.12rem; font-weight: 500; }

/* agents */
.agents .head { display: grid; gap: 14px; max-width: 640px; margin-bottom: 36px; }
.panel { background: var(--term-bg); color: var(--term-fg); border-radius: 10px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: hidden; }
@media (max-width: 640px) { .panel { grid-template-columns: minmax(0, 1fr); } }
.pane { padding: 18px 20px 20px; font: 400 0.8rem/1.7 var(--mono); min-width: 0; overflow-x: auto; border-bottom: 1px solid var(--term-rule); }
.pane:nth-child(odd) { border-right: 1px solid var(--term-rule); }
.pane:nth-last-child(-n+2) { border-bottom: 0; }
@media (max-width: 640px) { .pane:nth-child(odd) { border-right: 0; } .pane:nth-last-child(2) { border-bottom: 1px solid var(--term-rule); } }
.pane .h { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 10px; color: var(--term-dim); white-space: nowrap; }
.pane .h b { color: var(--term-fg); font-weight: 500; }
.agents .foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-top: 20px; }
.agents .foot p { color: var(--muted); font-size: 0.95rem; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chips span { font-size: 0.82rem; padding: 6px 10px; border: 1px solid var(--rule); border-radius: 999px; color: var(--muted); }

/* anywhere */
.anywhere .head { display: grid; gap: 14px; max-width: 640px; margin-bottom: 40px; }
.flow { display: grid; grid-template-columns: minmax(0, 1.3fr) 48px minmax(0, 1fr) 48px minmax(0, 0.9fr); align-items: center; gap: 16px; }
.sources { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.sources li { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--rule); border-radius: 6px; font-size: 0.92rem; font-weight: 500; min-width: 0; }
.sources svg { width: 18px; height: 18px; flex: none; }
.via .git { display: flex; align-items: center; gap: 10px; }
.via .git svg { width: 20px; height: 20px; flex: none; color: var(--muted); }
.arrow { height: 2px; background: var(--rule); position: relative; }
.arrow::after { content: ""; position: absolute; right: -1px; top: -4px; border: 5px solid transparent; border-left: 7px solid var(--muted); border-right: 0; }
.via, .dest { display: grid; gap: 6px; padding: 18px; border-radius: 8px; }
.via { border: 1px solid var(--rule); background: var(--paper-2); }
.via code { font-size: 0.95rem; }
.via span, .dest span:last-child { font-size: 0.85rem; color: var(--muted); }
.dest { border: 1.5px solid var(--signal); }
.mark-sm { font: 800 1.6rem/1 var(--display); color: var(--signal); }
@media (max-width: 860px) {
  .flow { grid-template-columns: minmax(0, 1fr); }
  .arrow { width: 2px; height: 28px; justify-self: center; }
  .arrow::after { right: auto; left: -4px; top: auto; bottom: -1px; border: 5px solid transparent; border-top: 7px solid var(--muted); border-bottom: 0; }
}

/* speed */
.speed .head { display: grid; gap: 14px; max-width: 640px; margin-bottom: 40px; }
.tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
@media (max-width: 720px) { .tiers { grid-template-columns: minmax(0, 1fr); } }
.tiers div { display: grid; gap: 8px; align-content: start; padding-top: 20px; border-top: 2px solid var(--ink); }
.tiers .fig { font-family: var(--display); font-weight: 800; font-size: clamp(2.4rem, 5vw, 3.4rem); line-height: 1; text-transform: uppercase; color: var(--signal); }
.tiers b { font-weight: 600; font-size: 1.05rem; }
.tiers p { color: var(--muted); font-size: 0.96rem; }
.more { margin-top: 36px; font-size: 0.95rem; color: var(--muted); }
.more a, .safety a { color: var(--ink); text-underline-offset: 3px; }
.safety { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--rule); max-width: 760px; }
.safety b { font-weight: 600; }

/* get started */
.start { background: var(--term-bg); color: var(--term-fg); }
.start + footer { border-top: 1px solid var(--term-rule); }
.start .wrap { display: grid; gap: 32px; }
.start .lede { color: var(--term-dim); }
.start h2 { color: var(--term-fg); }
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 0; border: 1px solid var(--term-rule); border-radius: 10px; overflow: hidden; }
.step { padding: 20px; display: grid; gap: 10px; min-width: 0; border-right: 1px solid var(--term-rule); }
.step:last-child { border-right: 0; }
.step.wide { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--term-rule); }
.os { display: flex; flex-wrap: wrap; gap: 4px; }
.os button { all: unset; cursor: pointer; font-size: 0.82rem; padding: 4px 9px; border-radius: 4px; color: var(--term-dim); }
.os button[aria-selected="true"] { background: var(--term-rule); color: var(--term-fg); }
.os button:hover { color: var(--term-fg); }
.step span { font-size: 0.85rem; color: var(--term-dim); }
.step pre { margin: 0; font: 400 0.86rem/1.7 var(--mono); overflow-x: auto; }
.start .btn.secondary { border-color: var(--term-rule); color: var(--term-fg); }
.start .btn.secondary:hover { border-color: var(--term-dim); }

footer { background: var(--term-bg); color: var(--term-dim); font-size: 0.86rem; }
footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 24px; }
footer nav { display: flex; gap: 20px; }
footer a { text-decoration: none; }
footer a:hover { color: var(--term-fg); }
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="mark" href="#top" aria-label="berth home">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="1" width="22" height="22" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5.5 7.5h13M5.5 12h13M5.5 16.5h7" stroke="currentColor" stroke-width="2"/><rect x="14.5" y="14.5" width="4.5" height="4.5" fill="var(--signal)"/></svg>
      berth
    </a>
    <nav class="links" aria-label="Site">
      <a href="/docs/quickstart/">Docs</a>
      <a href="https://github.com/kodnificent/berth">GitHub</a>
      <a href="#start">Install</a>
    </nav>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <h1>git worktree copies your code. <span class="copy">Berth copies everything else.</span></h1>
        <p class="lede">Each worktree gets its own ports, hostname, <code>.env</code>, dependencies and database. Run <code>npm run dev</code>, <code>rails server</code> or <code>docker compose up</code> in all of them at once.</p>
        <div class="actions">
          <a class="btn primary" href="https://github.com/kodnificent/berth">View on GitHub</a>
          <a class="btn secondary" href="/docs/quickstart/">Read the docs</a>
        </div>
        <p class="works">Any language · plain dev servers · local MySQL or Postgres · Docker Compose</p>
      </div>

      <div class="term">
        <div class="tabs" role="tablist" aria-label="Stack">
          <button type="button" role="tab" id="tab-dev" aria-selected="true" data-stack="dev">Dev server</button>
          <button type="button" role="tab" id="tab-db" aria-selected="false" data-stack="db">Local database</button>
          <button type="button" role="tab" id="tab-compose" aria-selected="false" data-stack="compose">Compose</button>
        </div>
        <pre id="term-out" aria-live="polite"></pre>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap fights">
      <div class="intro">
        <h2>Two worktrees fight over five things</h2>
        <p class="lede">A worktree copies tracked files and nothing else. Run two at once and they collide, so you end up testing one branch at a time.</p>
      </div>
      <div>
        <ul class="fight-list">
          <li><b>Ports</b><span>Both dev servers want port 3000.</span></li>
          <li><b>Names and cookies</b><span>Logging in on one worktree logs you out of the other.</span></li>
          <li><b>Databases</b><span>A migration on one branch breaks another branch's tests.</span></li>
          <li><b>Untracked files</b><span>A new worktree has no <code>.env</code> and no <code>node_modules/</code>.</span></li>
          <li><b>The one local database</b><span>Every worktree points at the same Postgres or MySQL.</span></li>
        </ul>
        <p class="answer">Berth gives each worktree its own. You start things exactly as you do in main.</p>
      </div>
    </div>
  </section>

  <section class="agents">
    <div class="wrap">
      <div class="head">
        <h2>Four agents, four running apps</h2>
        <p class="lede">Agents already work in worktrees. With berth, each one can run, migrate and test its branch for real, without waiting its turn or breaking a neighbour's data.</p>
      </div>
      <div class="panel">
        <div class="pane"><div class="h"><b>feat-coupons</b><span>Rails · local Postgres</span></div><span class="pr">$</span> bin/rails db:migrate<br><span class="ok">== AddCoupons: migrated</span><br><span class="pr">$</span> bin/rails test<br><span class="ok">214 runs, 0 failures</span></div>
        <div class="pane"><div class="h"><b>new-billing</b><span>Node · dev server</span></div><span class="pr">$</span> npm run dev<br><span class="ok">VITE ready</span> <span class="dim">on</span> <span class="as">:20003</span><br><span class="pr">$</span> berth status --json | jq .url<br><span class="dim">"http://new-billing.localhost:</span><span class="as">20002</span><span class="dim">"</span></div>
        <div class="pane"><div class="h"><b>fix-checkout</b><span>Docker Compose</span></div><span class="pr">$</span> docker compose up -d<br><span class="ok">[+] Running 4/4</span> <span class="dim">shop-fix-checkout</span><br><span class="pr">$</span> curl -s localhost:<span class="as">20000</span>/health<br><span class="ok">ok</span></div>
        <div class="pane"><div class="h"><b>drop-legacy</b><span>Django · local MySQL</span></div><span class="pr">$</span> python manage.py flush --no-input<br><span class="ok">Flushed shop__drop_legacy</span><br><span class="dim">main's database is untouched</span></div>
      </div>
      <div class="foot">
        <p>Agents run <code>berth status --json</code> to find their own URL and ports.</p>
      </div>
    </div>
  </section>

  <section class="anywhere">
    <div class="wrap">
      <div class="head">
        <h2>Works wherever you make worktrees</h2>
        <p class="lede">Berth works on git worktrees themselves, so it doesn't matter which tool made one. Install berth's git hook once and anything that runs <code>git worktree add</code> gets a full environment, with no plugin, wrapper or per-tool setup.</p>
      </div>
      <div class="flow">
        <ul class="sources" aria-label="Tools">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1.5" y="3" width="21" height="18" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M6 9l3.5 3L6 15M11.5 15.5H17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Your terminal</li>
